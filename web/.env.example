# ==============================================================================
# Ready2Code Next.js Frontend Environment Configuration
# ==============================================================================

# Public API Gateway (Client-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API Gateway (Next.js server-side rewrites)
# In Docker: http://api:8000/:path*
# Locally: http://localhost:8000/:path*
API_INTERNAL_URL=http://localhost:8000/:path*

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Port configuration
PORT=3000

# Error Monitoring (Optional Sentry DSN)
NEXT_PUBLIC_SENTRY_DSN=
