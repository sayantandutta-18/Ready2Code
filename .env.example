# ==============================================================================
# Ready2Code Full Stack Docker Compose Environment Configuration
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=ready2code
POSTGRES_PASSWORD=ready2code_secure_pass_2026
POSTGRES_DB=ready2code_prod
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=ready2code_redis_secret
REDIS_PORT=6379

# FastAPI Backend Configuration
API_PORT=8000
ENVIRONMENT=production
DEBUG=false
JWT_SECRET=change_me_to_a_long_cryptographic_random_string_in_production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ready2code.vercel.app

# Next.js Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Judge0 Execution Engine Configuration
JUDGE0_PORT=2358

# Optional Monitoring
SENTRY_DSN=
