# ==============================================================================
# Ready2Code - Docker Compose template (copy to .env, never commit .env)
# ==============================================================================

# PostgreSQL (Docker)
POSTGRES_USER=ready2code
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_DB=ready2code_dev
POSTGRES_PORT=5432

# Redis (Docker)
REDIS_PASSWORD=<choose-a-password>
REDIS_PORT=6379

# Judge0 (Docker, optional until checkpoint S1.2)
JUDGE0_PORT=2358