# ==============================================================================
# Ready2Code FastAPI Backend Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
ENVIRONMENT=development
DEBUG=false

# Database Connection (PostgreSQL for production, SQLite for local testing)
# Production: postgresql://ready2code:password@localhost:5432/ready2code_db
DATABASE_URL=sqlite:///./ready2code.db

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Judge0 Code Execution Engine
JUDGE0_URL=http://localhost:2358

# JWT Authentication
JWT_SECRET=ready2code-super-secret-jwt-key-change-in-prod-2026
JWT_ALGORITHM=HS256
JWT_EXPIRES_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ready2code.vercel.app

# Security & Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=120
SUBMISSION_RATE_LIMIT_PER_MINUTE=15
AI_RATE_LIMIT_PER_MINUTE=10

# Monitoring & Error Reporting (Sentry)
# SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
SENTRY_DSN=

# AI Features (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=
